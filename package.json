{
  "name": "classnode",
  "version": "2.1.1",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "pnpm --filter classnode-server dev",
    "dev:all": "bash dev.sh fg",
    "dev:start": "bash dev.sh start",
    "dev:stop": "bash dev.sh stop",
    "dev:restart": "bash dev.sh restart",
    "dev:status": "bash dev.sh status",
    "dev:logs": "bash dev.sh logs",
    "build": "next build && node scripts/check-classroom-browser-compat.mjs",
    "build:server": "pnpm --filter classnode-server build",
    "build:all": "pnpm build && pnpm build:server && pnpm package:web",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:mac:arm64": "node scripts/build-desktop.mjs --target aarch64-apple-darwin",
    "build:mac:intel": "node scripts/build-desktop.mjs --target x86_64-apple-darwin",
    "build:windows": "node scripts/build-desktop.mjs --target x86_64-pc-windows-msvc",
    "build:windows:arm64": "node scripts/build-desktop.mjs --target aarch64-pc-windows-msvc",
    "package:web": "node scripts/package-frontend.mjs web",
    "package:desktop": "node scripts/package-server.mjs",
    "start": "pnpm --filter classnode-server start",
    "tauri": "tauri",
    "prebuild": "node scripts/sync-version.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "lint": "eslint",
    "test": "pnpm test:scripts && pnpm test:client && pnpm test:server",
    "test:scripts": "node scripts/run-tests.mjs scripts",
    "test:client": "node scripts/run-tests.mjs client",
    "test:server": "pnpm --filter classnode-server test",
    "verify:browser": "node scripts/verify-release-browser.mjs",
    "verify:security": "node scripts/verify-phase2-browser.mjs",
    "verify:package": "node scripts/verify-packaged-data.mjs",
    "seed:worksheet": "pnpm --filter classnode-server exec tsx ../scripts/seed-math-worksheet.mjs",
    "seed:answers": "pnpm --filter classnode-server exec tsx ../scripts/seed-worksheet-demo.mjs",
    "db:generate": "pnpm --filter classnode-server db:generate",
    "db:push": "pnpm --filter classnode-server db:push",
    "db:studio": "pnpm --filter classnode-server db:studio",
    "version:sync": "node scripts/sync-version.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:package": "bash release.sh",
    "stop": "bash dev.sh stop",
    "sync-version": "node scripts/sync-version.mjs",
    "prepare-release": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@isoterik/react-word-cloud": "^1.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xyflow/react": "12.11.6",
    "@xyflow/system": "0.0.82",
    "docx": "^9.7.0",
    "jsxgraph": "1.13.3",
    "katex": "^0.17.0",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.1",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "mind-elixir": "5.15.1",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-sketch-canvas": "8.0.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "^5"
  }
}
