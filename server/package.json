{
  "name": "classnode-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "fsevents": false,
    "prisma": true
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "test": "pnpm build || exit 1; node --test dist/tests/*.test.js > ../.test-server.log 2>&1; code=$?; cat ../.test-server.log; exit $code",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@prisma/client": "^6.0.0",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "express": "^4.21.0",
    "katex": "^0.17.0",
    "mathml2omml": "^0.5.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.0.0",
    "sharp": "^0.35.1",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
