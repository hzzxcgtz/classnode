generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  // Desktop packages are cross-compiled, so the generated client must carry
  // engines for every supported runtime rather than only the build machine.
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 教师全局配置（管理密码、端口号等）
model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// AI 智能体配置
model Agent {
  id        String   @id @default(uuid())
  name      String   // 本地展示名称
  logo      String?  // 本地 Logo 路径
  platform  String   // 平台类型: coze / coze-agent / wenxin / zhipuai
  apiUrl    String?  // API URL (for Coze Agent)
  apiKey    String   // AES 加密后的 API Key / Token
  botId     String?  // Bot ID (for Coze)
  /// ★ 2026-09-25：指向一份**共享** API Token（`PlatformToken`）。可空。
  /// 🔴 `NULL` 是一条**真路**，不是「还没填」：老数据全是 `NULL` ⇒ 沿用自带的 `apiKey`，
  /// 行为与改动前**逐字相同**；把这一列全部置空就等于**回滚**。
  /// 判据：`platform === 'coze'` 且本列非空 ⇒ 用共享那份，忽略 `apiKey`。
  credentialId String?
  extra     String?  // 额外配置 (JSON)
  enabled   Boolean  @default(true)
  /// ★ M7b：用途。`tutoring`（学伴，学生可见）| `analysis`（分析型，**学生绝不可见**）。
  /// 🔴 它是一门**闸**，不是一个标签 —— 见 `services/agent-purpose.ts` 的文件头。
  purpose   String   @default("tutoring")
  greeting         String?   // 开场白
  greetingFetchedAt DateTime? // 开场白最后拉取时间
  lastCheckAt       DateTime? // 最后连通性检查时间
  lastCheckOk       Boolean?  // 最后检查是否成功
  lastCheckError    String?   // 最后检查错误信息
  createdAt         DateTime @default(now())
  updatedAt DateTime @updatedAt

  classroomAgents ClassroomAgent[]
  credential      PlatformToken?  @relation(fields: [credentialId], references: [id], onDelete: Restrict)
}

/// ★ 2026-09-25：**共享的 API Token**。
///
/// 🔴 存在的理由：Coze 低代码的 Token 属于**扣子账号**、不属于 Bot ——
/// 同一个号做出来的多个智能体本该共用一份。从前它是 `Agent.apiKey`，
/// 每个智能体一份 ⇒ 换一次要改 N 遍，而且没有任何地方记着它 30 天后会过期。
///
/// ⚠️ **表里可以有多份**：一个老师完全可能有两个扣子号。
/// ⚠️ 系统**认不出账号**，只认「Token 字符串一样」—— 所以不做任何自动合并，
///    由教师自己决定哪几个智能体指向同一份。
model PlatformToken {
  id        String   @id @default(uuid())
  /// 今天是 `'coze'`（Coze 低代码）。留通用是为了将来别的平台要挂时不用再迁一次表。
  platform  String
  /// **备注：这是谁的账号**（教师自己写）。必填 —— 一份没有名字的凭据在列表里等于没有。
  label     String
  /// AES 加密后的 Token（同一个 `services/crypto.ts`）。响应里一律掩码。
  token     String
  /// 有效期。
  /// 🔴 **可空，且「空」是一个要被催促的状态**，不是沉默的默认：迁移来的记录**不猜日期**
  /// （见 `platform-token-migration.ts`），界面上显示「未设置有效期」并催教师去填。
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents Agent[]
}

// 头像库
model Avatar {
  id          Int       @id @default(autoincrement())
  svgContent  String
  category    String    @default("student") // student / class
  gender      String    @default("neutral") // boy / girl / neutral
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  source      String    @default("teacher") // teacher / student
  createdAt   DateTime  @default(now())

  students Student[]
  classes  Class[]
}

// 班级
model Class {
  id        String   @id @default(uuid())
  name      String   // 班级名称
  avatarId  Int?     // 班级图标
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avatar           Avatar?           @relation(fields: [avatarId], references: [id])
  students         Student[]
  groups           ClassGroup[]
  classroomClasses ClassroomClass[]
}

// 班级分组（持久化，可在创建课堂时复用）
model ClassGroup {
  id         String   @id @default(uuid())
  classId    String
  name       String   // 组名
  studentIds String   @default("[]") // 学生 ID 数组 JSON ["uuid1","uuid2"]
  createdAt  DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
}

// 学生
model Student {
  id        String   @id @default(uuid())
  classId   String
  name      String   // 学生姓名
  studentNo String?  // 学号
  gender    String?  // boy / girl（用于头像匹配、自动分配）
  tag       String?  // 分组标签 (如 A组, B组)
  avatarId           Int?     // 学生头像
  avatarChangeTokens Int      @default(0) // 教师奖励的可换头像次数
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class     Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  avatar    Avatar?         @relation(fields: [avatarId], references: [id])
  classroomStudents ClassroomStudent[]
}

// 课堂
model Classroom {
  id        String   @id @default(uuid())
  code      String?  @unique // 4位互动码（结束课堂时置空以回收）
  title     String?  // 课堂标题
  mode      String   @default("standard") // standard / advanced
  status    String   @default("active") // active / paused / ended
  allowStudentStop Boolean @default(true)
  /// ★ 2026-09-25：是否允许学生**提问**（智能学伴的输入）。
  /// 🔴 与 `status = 'paused'`（「暂停课堂」）是**两件事**：那个封住三件套整体，
  /// 这个只封住「问问题」这一件事（学生仍可看学习单、看探究网页）。
  /// 它承接的是**原来那个名字起错的按钮**：工具栏上写着「暂停学生提问」的按钮
  /// 其实调的是 `POST /:id/pause`（整节课），教师 2026-09-25 要求把它拆开。
  allowStudentAsk Boolean @default(true)
  allowStudentExport Boolean @default(true)
  allowFollowUps Boolean @default(true)
  /// M5a：课堂级「锁定作答」。`false`（默认）= 未锁定。
  /// ⚠️ 改成 true 之后，学习单的**保存**会被 409 拒（`code: 'answers-locked'`），
  /// 而**交卷仍然放行**（规格 §3.2）。与 `allowResubmit`（学习单级、题级语义）是两层。
  answersLocked Boolean @default(false)
  /// 探究空间：是否采集**画面**（截图）。关掉后学生端不传任何图片，
  /// 只传文字档（可见性 + 滚动深度）—— 那是给老设备用的便宜档。
  webappCaptureEnabled Boolean @default(true)
  /// 探究空间：缩略图目标宽度（像素）。服务端夹在 160~640 之间再下发。
  webappThumbnailWidth Int @default(320)
  /// 探究空间：**图墙档**的截图基准周期（毫秒）。详情档由服务端按比例推。
  webappFrameIntervalMs Int @default(10000)
  /// 探究空间：**详情档**周期的教师覆盖值（毫秒），可空。
  /// `null` = 没调过 ⇒ 按基准派生（`detailIntervalFor`，基准的 1/5），那是 P2.2 的原行为。
  /// ⚠️ **可空是有意的**：基准是教师按**设备能力**选的 —— 一个班把基准调到 30 秒，
  /// 正是因为设备跑不动。给这种课堂固定一个 2 秒详情档，等于把他刚避开的代价加回去。
  webappDetailIntervalMs Int?
  createdAt DateTime @default(now())
  endedAt   DateTime?

  classes          ClassroomClass[]
  groups           ClassroomGroup[]
  groupMembers     ClassroomGroupMember[]
  students         ClassroomStudent[]
  classroomAgents  ClassroomAgent[]
  modules          ClassroomModule[]
  webapps          ClassroomWebapp[]
  worksheets         ClassroomWorksheet[]
  worksheetResponses WorksheetResponse[]
  webappUsages     WebappUsage[]
  interactions     Interaction[]
  shieldWarnings   ShieldWarning[]
  notifications    TeacherNotification[]
  // ★ M7a：按题的分析载荷（反向关系）。加它**不改动 Classroom 自己的 DDL**。
  worksheetAnalyses WorksheetQuestionAnalysis[]
}

// 课堂关联的班级（标准模式）
model ClassroomClass {
  classroomId String
  classId     String

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classroomId, classId])
}

// 课堂分组（高级模式）
model ClassroomGroup {
  id          String @id @default(uuid())
  classroomId String
  name        String // 创建课堂时的小组名称快照
  sourceClassGroupId String? // 创建时关联的班级分组；仅作溯源，不参与运行时匹配

  classroom Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  students  ClassroomStudent[]
  members   ClassroomGroupMember[]
  materials ClassroomGroupMaterial[]

  @@index([classroomId])
}

/// 小组级课堂材料：高级模式下每个小组各自指定的智能体 / 探究网页 /（将来）学习单。
/// ⚠️ `targetId` 是**多态**的（Agent.id / Webapp.id / 将来 Worksheet.id），
/// 所以**没有真外键** —— 补偿是 routes 里的删除守卫（见 agents.ts / webapps.ts），
/// 以及运行期容忍悬空 id（读不到 ⇒ 当作未配置）。
model ClassroomGroupMaterial {
  id        String   @id @default(uuid())
  groupId   String
  kind      String
  targetId  String
  createdAt DateTime @default(now())

  group ClassroomGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// 每组每种材料**至多一个** ⇒ 「单选」是数据库层面的约束，不是 UI 约定。
  @@unique([groupId, kind])
  /// 反查「这个材料被哪些组用了」—— 删除守卫与 /usage 走这条。
  @@index([kind, targetId])
}

// 课堂创建时冻结的小组成员名单。班级分组日后改名、换人不会影响课堂及历史记录。
model ClassroomGroupMember {
  id          String @id @default(uuid())
  classroomId String
  groupId     String
  studentId   String?
  name        String
  studentNo   String?

  classroom Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  group     ClassroomGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([classroomId])
  @@index([groupId])
}

// 课堂中的智能体关联
model ClassroomAgent {
  id          String @id @default(uuid())
  classroomId String
  agentId     String

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, agentId])
}

// 课堂模块三态（学习单 / 探究空间 / 智能学伴）
model ClassroomModule {
  id          String @id @default(uuid())
  classroomId String
  moduleKey   String // 'learning-sheet' | 'explorer' | 'companion'
  state       String @default("preview") // 'open' | 'preview' | 'hidden'

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  // 勿删 @default(now())：它与 index.ts 里的手写 DDL 对齐，是承重的。改成裸 @updatedAt 会造成漂移，
  // 下次 db push 会重建本表，而同步块按表名探测、不会重跑，两边就此不一致。
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([classroomId, moduleKey])
  @@index([classroomId])
}

// 探究空间：教师上传的静态网页（规格 §5.2）。
// entryPath 存的是**包内相对路径**（如 index.html），不是磁盘路径 ——
// 绝对路径会把数据目录的位置写进数据库，换机器就废；而磁盘目录由 id 直接决定
// （<webappsRoot>/<id>/），不需要在库里再存一份。
model Webapp {
  id        String   @id @default(uuid())
  name      String
  entryPath String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classrooms ClassroomWebapp[]
  usages     WebappUsage[]
}

// 课堂关联的探究空间网页。
//
// ⚠️ 本模型的 schema 定义**必须与 index.ts 的手写 DDL 逐字对齐**，否则下次 db push
// 会重建本表，而同步块按表名探测、不会重跑，两边就此不一致
// （同 ClassroomModule :194-196 的告诫，新表照这条规矩办）。
//
// createdAt 不是装饰：学生端按「关联顺序」下发网页列表，而 @@unique([classroomId, webappId])
// 的索引次序是 classroomId 在前、给不出 webappId 维度的顺序，没有时间列就没有稳定次序。
// ClassroomStudent.joinTime 是同一个用法。
model ClassroomWebapp {
  id          String   @id @default(uuid())
  classroomId String
  webappId    String
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  webapp    Webapp    @relation(fields: [webappId], references: [id], onDelete: Cascade)

  @@unique([classroomId, webappId])
  // 删网页前要 count({ where: { webappId } })；上面那个唯一索引以 classroomId 打头，
  // 给不了这个维度，缺了它每次删除都是全表扫。
  @@index([webappId])
}

// 探究空间使用汇总 —— 规格 §5.5 的「唯一落盘项」，也是 P2 唯一落盘的东西。
//
// 整条实时链路的帧与计数**只存内存**（Ruling 8），课堂结束时由 drainWebappMonitor()
// 一次性取出、写进本表、再清空内存。所以这里留下的就是课后报告的全部数据来源。
//
// studentId 是 ClassroomStudent 的**参与记录 ID**，不是 Student 表 ID ——
// 与 Interaction.studentId 同口径（小组模式下根本没有 Student 行，用 Student ID 会让
// 分组课堂的汇总整批丢失）。webappId 是 Webapp 表 ID。
//
// ⚠️ 本模型的 schema 定义**必须与 index.ts 的手写 DDL 逐字对齐**，理由同
// ClassroomWebapp :219-221 —— 手写 DDL 是从 `prisma db push` 到空库后 dump
// sqlite_master 得到的，不是照着这里手抄的。
model WebappUsage {
  id          String   @id @default(uuid())
  classroomId String
  webappId    String
  studentId   String
  // 时长 = 该参与者在本网页上「首帧 → 末帧」的墙上时钟跨度（见 socket/index.ts 的
  // WebappMonitorState 注释：另一种算法是用 visibility 事件累计前台时长，两种都受
  // 「按需推流」影响 —— 没有教师在看时学生根本不推，两种算法都看不到那段区间）。
  durationMs  Int      @default(0)
  clicks      Int      @default(0)
  inputs      Int      @default(0)
  maxDepth    Int      @default(0)
  reports     Int      @default(0)
  // durationMs 是「首帧 → 末帧」推出来的，这个数字是那条推导的证据（只采到 1 帧时时长为 0）。
  frameCount  Int      @default(0)
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  webapp    Webapp    @relation(fields: [webappId], references: [id], onDelete: Cascade)

  // 一个参与者对一个网页只留一行 —— **后一次课堂结束覆盖前一次**。
  //
  // ⚠️ 这条唯一键存在的理由**不是**「防止重复请求写重」（曾经这里是这么写的，那句话
  // 没有依据，而且被仓内代码直接证否）：`canTransition` 允许 `restore: ['ended']`，
  // 也就是「结束错了 → 恢复 → 上完 → 再结束」是一条**合法且常见**的路径，一个课堂
  // 被结束两次是正常的。写入方（socket/index.ts 的 recordWebappSummary）因此必须
  // **按这把键替换**而不是追加，见那里的注释。
  @@unique([classroomId, studentId, webappId])
  // 课后报告按课堂取全量；按 webappId 的维度留给「这个网页被哪些课堂用过」。
  @@index([classroomId])
  @@index([webappId])
}

// 课堂参与者。标准模式关联真实学生；分组/高级模式直接关联 ClassroomGroup，绝不再创建虚拟 Student。
model ClassroomStudent {
  id          String   @id @default(uuid())
  classroomId String
  type        String   @default("student") // student / group
  studentId   String?
  groupId     String?
  joinTime    DateTime @default(now())
  status      String   @default("offline") // online / offline
  totalRounds Int      @default(0)
  warningCount Int    @default(0)
  blacklisted  Boolean @default(false)

  classroom Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     ClassroomGroup? @relation(fields: [groupId], references: [id])
  messages  Message[]
  worksheetResponses WorksheetResponse[]

  @@unique([classroomId, studentId])
  @@unique([classroomId, groupId])
  @@index([classroomId, status])
  @@index([studentId])
}

// 互动消息
model Message {
  id               String   @id @default(uuid())
  classroomId      String
  studentId        String
  content          String   // 消息原文
  role             String   // user / assistant
  displayName      String?  // 脱敏后的显示名
  roundIndex       Int?     // 第几轮
  agentId          String?  // 回复的智能体
  fileUrls         String?  // 附件 URL 列表（JSON 数组）
  fileNames        String?  // 附件名称列表（JSON 数组）
  followUps        String?  // 追问建议列表（JSON 字符串数组）
  createdAt        DateTime @default(now())

  classroomStudent ClassroomStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([classroomId])
  @@index([studentId])
  @@index([classroomId, createdAt])
}

// 屏蔽词
model ShieldWord {
  id        String   @id @default(uuid())
  word      String   @unique
  builtin   Boolean  @default(false)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 屏蔽系统配置
model ShieldConfig {
  id             String @id @default(uuid())
  autoBlackCount Int    @default(0) // 0=不自动黑屏，N=警告N次后自动黑屏
  rateLimit      Int    @default(6) // 每分钟最多提问次数，0=不限制
}

// 屏蔽警告记录
model ShieldWarning {
  id          String   @id @default(uuid())
  classroomId String
  studentId   String   // ClassroomStudent.id
  word        String   // 触发的屏蔽词
  content     String?  // 触发时的消息内容片段
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

// 教师通知（全班广播或发给指定学生，持久化到 DB 支持导出）
model TeacherNotification {
  id          String   @id @default(uuid())
  classroomId String
  studentId   String?  // null = 全班广播 或 定向到组，非空 = 发送给指定学生（Student.id）
  groupId     String?  // 定向到组（高级/分组模式），studentId=null 时 groupId 有值
  content     String
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, createdAt])
  @@index([classroomId, groupId])
}

// 互动记录汇总
model Interaction {
  id          String   @id @default(uuid())
  classroomId String
  studentId   String
  totalRounds Int      @default(0)
  firstMsgLen Int?     // 首问字数
  avgTime     Int?     // 平均响应时间(秒)
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@index([classroomId])
}

// ——— 学习单（P1）———

/// 学习单（模板，可复用）。题目结构存 JSON 树，见 09-19 §6.1 的三条决策。
///
/// ⚠️ 本模型的 schema 定义**必须与 index.ts 的手写 DDL 逐字对齐**（DDL 在
/// services/worksheet-schema.ts 里），理由同 ClassroomWebapp :262-264 ——
/// 手写 DDL 是从 `prisma db push` 到空库后 dump sqlite_master 得到的，
/// 不是照着这里手抄的。两边分叉的后果见规格 §4.1.2 的告诫。
model Worksheet {
  id            String   @id @default(uuid())
  title         String
  description   String?
  schemaVersion Int      @default(1)   // ★ 题型演进时迁移的依据
  content       Json                    // 题目结构（嵌套树；见 4.3）
  settings      Json                    // { allowResubmit, autoGrade } —— 见 4.4
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classrooms    ClassroomWorksheet[]
  responses     WorksheetResponse[]
  // ★ M7a：按题的分析载荷（反向关系）。加这一行**不改动 Worksheet 自己的 DDL** —— 已实测
  // （在 /tmp 探针库上 db push 后 dump，与本仓 `worksheet-schema.ts` 里那份手写 DDL 逐字相同，
  // 差异只有该文件刻意补的行尾分号）。
  analyses      WorksheetQuestionAnalysis[]
}

// ★ M7a：按题的一次性聚合载荷。**派生数据**，所以跟着学习单一起删（Cascade）。
// ⚠️ 与 `WorksheetAnswer.value` 里那个 `recognized`（单人笔迹识别的预留字段）**不是同一个对象**：
//    那个是「一个学生的笔迹识别成文字」，这个是「全班在某一道题上的情况」。
model WorksheetQuestionAnalysis {
  id           String   @id @default(uuid())
  // ★ 课程 id 是**键的一部分**：同一份学习单可以被多个课堂引用（`ClassroomWorksheet` 的唯一键
  // 是 (classroomId, worksheetId)）⇒ 只按 (worksheetId, questionId) 存会让两个班**共用一行**，
  // 在乙班点「分析」看到的是甲班的数据，点「重新生成」会**静默覆盖**甲班那份。
  classroomId  String
  worksheetId  String
  questionId   String   // content 树里的稳定 id，**不是下标**（与 WorksheetAnswer.questionId 同口径）
  // 🔴 `aggregate` 是**唯一的事实来源**：`payloadKind` 由 `payloadKindOf(entries)` 算、
  // 「已交数」就是 `entries.length`。这两样原先各占一列，而**没有任何地方读它们**
  // —— 那等于给同一件事留了两个会静默分叉的来源（独立审查 M4）。已删。
  // ⚠️ `totalCount` **留着**：它是冻结的分母，`aggregate` 里推不出来（分母可能大于条目数）。
  aggregate    Json     // 本地聚合的结构化快照 —— 唯一的事实来源
  totalCount   Int      // 该题应作答的参与者数（高级模式下**不是**全班人数）
  computedAt   DateTime @default(now())
  // ↓ 下面四格本版恒为 null —— 它们就是「留的接口」（用户 2026-09-25 裁定 1）
  narrative    String?  // 以后：AI 写的解读
  perStudent   Json?    // 以后：按人的建议
  agentId      String?  // 以后：用了哪个分析型智能体
  model        String?  // 以后：平台 / 模型标识

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  worksheet Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)

  @@unique([classroomId, worksheetId, questionId])
}

/// 学习单 ↔ 课堂的**课堂级**关联（standard / group 模式的权威来源）。
/// ⚠️ 与 ClassroomWebapp 同构：进 advanced 模式后权威来源变成「每组一份」。
model ClassroomWorksheet {
  id          String   @id @default(uuid())
  classroomId String
  worksheetId String
  createdAt   DateTime @default(now())   // ★ 排序键。理由与 ClassroomWebapp 逐字同源

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  worksheet Worksheet @relation(fields: [worksheetId], references: [id])

  @@unique([classroomId, worksheetId])
  @@index([worksheetId])
}

/// 参与者在某个课堂里对某份学习单的作答会话。
/// 🔴 participantId 指向 ClassroomStudent.id —— 那个 id **既可能是学生、也可能是小组**（§1.2）。
model WorksheetResponse {
  id            String   @id @default(uuid())
  classroomId   String
  worksheetId   String
  participantId String
  status        String   @default("not-started")  // not-started | in-progress | submitted
  startedAt     DateTime?
  submittedAt   DateTime?
  updatedAt     DateTime @updatedAt

  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  worksheet   Worksheet        @relation(fields: [worksheetId], references: [id])
  participant ClassroomStudent @relation(fields: [participantId], references: [id], onDelete: Cascade)
  answers     WorksheetAnswer[]

  @@unique([classroomId, worksheetId, participantId])
  @@index([classroomId])
}

/// 逐题一行 —— 实时看板的**唯一**数据源（09-19 §6.1 决策 2：40 人 × 20 题 = 800 行/课，SQLite 无压力）。
model WorksheetAnswer {
  id           String   @id @default(uuid())
  responseId   String
  questionId   String    // ★ content 树里的稳定 id，**不是下标**（§3-P）
  value        Json?     // 答案（格式见 4.3）
  status       String   @default("unanswered")  // unanswered | draft | submitted
  isCorrect    Boolean?  // 仅 autoGrade 开启且已提交时有值。★ M4a 起语义**收窄为「全对」**，由 gradeState 派生写入
  gradeState   String?   // ★ M4a（§12）：correct | partial | incorrect —— null = 未判分（主观题 / 关掉自动判分）
  score        Float?    // ★ M4a（§12）：数值得分（= 该题「全对」或「半对」那个数）。与 gradeState 同生共死
  reviewedAt   DateTime? // ★ 教师的「已查看」标记（§3-AA）
  submittedAt  DateTime? // 定稿时间戳（供 P4 智能体分析）

  response WorksheetResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([responseId])
}
